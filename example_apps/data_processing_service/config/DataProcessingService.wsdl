                  <xsd:annotation>
                     <xsd:documentation>Unique identifier for the processing request</xsd:documentation>
                  </xsd:annotation>
               </xsd:element>
               <xsd:element name="RequestType" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="CategoryCode" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="5"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="ItemData" type="tns:ItemData" nillable="false"/>
               <xsd:element name="Metadata" type="tns:RequestMetadata" nillable="false"/>
               <xsd:element name="ProcessingOptions" type="tns:ProcessingOptions" nillable="false"/>
