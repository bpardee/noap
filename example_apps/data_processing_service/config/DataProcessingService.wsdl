               <xsd:element name="ItemAttributes" type="tns:ItemAttributes" nillable="false"/>
               <xsd:element name="PreviousLocation" type="tns:ItemLocation" nillable="true"/>
               <xsd:element name="ContactInfo" type="tns:ContactInfo" nillable="false"/>
               <xsd:element name="NumericValue" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="20"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="DateValue" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="10"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="CategoryCode" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="8"/>
