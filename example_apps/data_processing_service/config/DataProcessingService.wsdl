                        <xsd:maxLength value="100"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
            </xsd:sequence>
         </xsd:complexType>
         
         <xsd:complexType name="FinancialHistory">
