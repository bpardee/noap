                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="MonthsAtLocation" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="3"/>
