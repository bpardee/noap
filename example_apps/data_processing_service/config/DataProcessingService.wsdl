                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="SecondaryContact" type="xsd:string" nillable="true">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="15"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
