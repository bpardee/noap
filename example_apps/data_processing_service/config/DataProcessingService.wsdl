                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="50"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="ItemName" type="tns:ItemName" nillable="false"/>
