                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="DocumentType" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="20"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="DocumentMetadata" type="tns:DocumentMetadata" nillable="false"/>
               <xsd:element name="ContentSections" type="tns:ContentSections" nillable="true"/>
            </xsd:sequence>
         </xsd:complexType>
         
         <xsd:complexType name="DocumentMetadata">
