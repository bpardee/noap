                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="SecondaryName" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="50"/>
