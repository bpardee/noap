               <xsd:element name="FileSize" type="xsd:integer" nillable="false"/>
               <xsd:element name="MimeType" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="50"/>
