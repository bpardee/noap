                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="YearsAtLocation" type="xsd:string" nillable="false">
                  <xsd:simpleType>
                     <xsd:restriction base="xsd:string">
                        <xsd:maxLength value="2"/>
                        <xsd:whiteSpace value="collapse"/>
                     </xsd:restriction>
                  </xsd:simpleType>
               </xsd:element>
            </xsd:sequence>
         </xsd:complexType>
         
         <xsd:complexType name="ItemName">
            <xsd:sequence>
