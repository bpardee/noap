                  </xsd:simpleType>
               </xsd:element>
               <xsd:element name="IncludeDetails" type="xsd:boolean" nillable="false"/>
               <xsd:element name="IncludeHistory" type="xsd:boolean" nillable="false"/>
            </xsd:sequence>
         </xsd:complexType>
         
